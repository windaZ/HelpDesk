<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HelpDesk.Views"
        Title="HelpDesk — Редактирование заявки" 
        Height="550" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        MinHeight="500"
        MinWidth="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование заявки"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"
                   Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Заявка №: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="TicketIdTextBlock" Text="0" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Text="Категория" FontSize="14" Margin="0,0,0,5" Grid.Row="2"/>
        <ComboBox x:Name="CategoryComboBox" 
                  Height="35" 
                  FontSize="14" 
                  Margin="0,0,0,15" 
                  Grid.Row="3"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Text="Описание" FontSize="14" Margin="0,0,0,5" Grid.Row="4"/>
        <TextBox x:Name="DescriptionTextBox" 
                 FontSize="14" 
                 Margin="0,0,0,15" 
                 Grid.Row="5"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Padding="5"/>

        <TextBlock Text="Приоритет" FontSize="14" Margin="0,0,0,5" Grid.Row="6"/>
        <ComboBox x:Name="PriorityComboBox" 
                  Height="35" 
                  FontSize="14" 
                  Margin="0,0,0,15" 
                  Grid.Row="7"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <TextBlock Text="Статус" FontSize="14" Margin="0,0,0,5" Grid.Row="8"/>
        <ComboBox x:Name="StatusComboBox" 
                  Height="35" 
                  FontSize="14" 
                  Margin="0,0,0,20" 
                  Grid.Row="9"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="Новая"/>
            <ComboBoxItem Content="В работе"/>
            <ComboBoxItem Content="Выполнена"/>
            <ComboBoxItem Content="Отклонена"/>
        </ComboBox>

        <UniformGrid Columns="2" Grid.Row="10">
            <Button x:Name="SaveButton" 
                    Content="Сохранить изменения" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CancelButton_Click"/>
        </UniformGrid>
    </Grid>
</Window>
