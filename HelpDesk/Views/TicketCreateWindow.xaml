<Window x:Class="HelpDesk.Views.TicketCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk – Новая заявка"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Новая заявка"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Категория"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="2"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="0"
                  Margin="0,0,0,15">
            <ComboBoxItem Content="Выберите категорию" IsEnabled="False"/>
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Grid.Row="3"
                   Text="Описание проблемы"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="4"
                 FontSize="14"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 Padding="5"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="6"
                   Text="Приоритет"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="PriorityComboBox"
                  Grid.Row="7"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="1"
                  Margin="0,0,0,20">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Grid.Column="0"
                    Content="Сохранить"
                    Height="38"
                    FontSize="14"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Отмена"
                    Height="38"
                    FontSize="14"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
