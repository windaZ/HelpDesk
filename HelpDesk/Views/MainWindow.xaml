<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk – Заявки"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Панель поиска и фильтров -->
            <RowDefinition Height="*"/>
            <!-- 2: Таблица заявок (занимает всё свободное место) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Панель кнопок действий -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Заявки технической поддержки"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Панель фильтрации -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="32"
                     FontSize="14"/>

            <ComboBox x:Name="StatusComboBox"
                      Grid.Column="2"
                      Height="32"
                      FontSize="14"/>

            <Button x:Name="SearchButton"
                    Grid.Column="4"
                    Content="Найти"
                    Height="32"
                    FontSize="14"/>
        </Grid>

        <!-- Основная таблица данных -->
        <DataGrid x:Name="TicketsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Margin="0,0,0,15"/>

        <!-- Нижняя панель управления -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="AddTicketButton"
                    Content="Добавить"
                    Width="110"
                    Height="35"
                    Margin="5"/>

            <Button x:Name="EditTicketButton"
                    Content="Редактировать"
                    Width="120"
                    Height="35"
                    Margin="5"/>

            <Button x:Name="DeleteTicketButton"
                    Content="Удалить"
                    Width="110"
                    Height="35"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
